<Bindings>
	<Binding name="NLPT_CYCLE_SPEC" header="NYTELYTEPALADINTOOLKIT" category="ADDONS">
		if not NyteLytePaladinToolkit.dormant then NyteLytePaladinToolkit.SpecProfile:Cycle() end
	</Binding>
	<Binding name="NLPT_TOGGLE_LOCK" category="ADDONS">
		if not NyteLytePaladinToolkit.dormant then NyteLytePaladinToolkit.Frames:ToggleLock() end
	</Binding>
	<Binding name="CLICK NyteLytePaladinToolkitBuffButton:LeftButton" category="ADDONS"/>
	<Binding name="NLPT_TOGGLE_GRID" category="ADDONS">
		if not NyteLytePaladinToolkit.dormant then NyteLytePaladinToolkit.BlessingGrid:Toggle() end
	</Binding>
</Bindings>
